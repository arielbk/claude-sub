{
  "name": "claude-sub",
  "version": "0.4.0-rc.0",
  "description": "PATH shim that routes claude -p invocations through interactive Claude when CLAUDE_USE_SUB is set",
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "main": "./dist/shim.js",
  "bin": {
    "claude": "./dist/shim.js",
    "csub": "./dist/csub.js",
    "claude-sub": "./dist/csub.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "!dist/**/__tests__/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true",
    "test": "vitest run",
    "test:e2e": "CLAUDE_USE_SUB_E2E=1 vitest run --reporter=verbose",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
