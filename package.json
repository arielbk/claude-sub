{
  "name": "claude-plan-wrapper",
  "version": "0.1.0",
  "description": "PATH shim that routes claude -p invocations through interactive Claude when CLAUDE_USE_SUB=1",
  "type": "module",
  "main": "./dist/shim.js",
  "bin": {
    "claude": "./dist/shim.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "dist/**/*.js.map",
    "!dist/**/__tests__/**",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:e2e": "CLAUDE_USE_SUB_E2E=1 vitest run --reporter=verbose"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  }
}
